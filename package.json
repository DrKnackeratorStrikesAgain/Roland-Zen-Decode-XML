  "description": "Tool to decode Roland editor XML files (Jupiter X/Xm and ZenCore) and generate JSON/JS with byte offsets and SYSEX locations",
  "main": "decode.js",
  "type": "module",
  "scripts": {
    "decode": "node decode.js",
    "compare-schema": "node compareSchemaJson.js",
    "fix-broken-xml": "node fixBrokenXml.js",
