  },
  "keywords": [
    "roland",
    "jupiter",
    "zencore",
    "sysex",
    "midi"
  ],
  "license": "MIT",
  "dependencies": {
  },
  "devDependencies": {
    "fast-xml-parser": "^4.3.2",
    "markdown-to-html-cli": "^5.0.4",
    "pdf-parse": "^2.4.5"
  }
}
